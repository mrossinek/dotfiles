#!/bin/sh

enable_monitor() {
  notify-send -u normal "Enabling eDP"
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false })'
}

disable_monitor() {
  notify-send -u normal "Disabling eDP"
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })'
}

if hyprctl monitors | grep eDP-1; then
  disable_monitor
else
  enable_monitor
fi
